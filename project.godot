; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Birb"
run/main_scene="res://resources/scenes/gameplay.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Scene="*res://scripts/global/scene.gd"
Data="*res://scripts/global/data.gd"
Abilities="*res://scripts/global/abilities.gd"
Crafting="*res://scripts/global/crafting.gd"

[debug]

gdscript/warnings/shadowed_variable=0
gdscript/warnings/unsafe_void_return=2
gdscript/warnings/static_called_on_instance=2
gdscript/warnings/redundant_static_unload=2
gdscript/warnings/redundant_await=2
gdscript/warnings/assert_always_true=0
gdscript/warnings/assert_always_false=2
gdscript/warnings/integer_division=2
gdscript/warnings/narrowing_conversion=2
gdscript/warnings/int_as_enum_without_cast=2
gdscript/warnings/int_as_enum_without_match=2
gdscript/warnings/empty_file=2
gdscript/warnings/deprecated_keyword=2

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=false

[editor]

script/templates_search_path="res://scripts/templates"

[editor_plugins]

enabled=PackedStringArray("res://addons/language_converter/plugin.cfg")

